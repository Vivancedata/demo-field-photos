#!/usr/bin/env bash
# Fast gate that Claude Code runs before a session can finish: `npm run verify`
# minus the Next.js production build. No API key, browser or deploy needed.
# The full check before a PR is still `npm run verify` (CI adds the e2e smoke).
set -euo pipefail
cd "$(dirname "$0")/.."

npm ci
npm run lint
npm run typecheck
npm run test
